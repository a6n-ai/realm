# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# turborepo
.turbo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploads (keep dir, ignore contents)
apps/tiffin-grab/public/uploads/*
!apps/tiffin-grab/public/uploads/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge-graph artifacts
graphify-out/

# AI tooling / agent context (keep local, never commit)
.claude/
.cursor/
.agents/
.superpowers/
.planning/
.idea/
.mcp.json
skills-lock.json
docs/
.vcscore

# playwright mcp session artifacts (console dumps + page snapshots)
.playwright-mcp/

# playwright e2e (tiffin-grab)
apps/tiffin-grab/e2e/.auth/
apps/tiffin-grab/e2e/test-results/
apps/tiffin-grab/e2e/playwright-report/
apps/tiffin-grab/e2e/blob-report/

# openspec scratch + local screenshots (not part of the repo)
openspec/
/Screenshot*.png
*.jpg
*.jpeg
*.png
tiffingrab.ca.txt
.remember

# real static assets, not scratch screenshots — allowlisted against the
# blanket image ignore above
!apps/puchkaman/public/instagram/*.jpg
!apps/puchkaman/public/about/*.jpg
!apps/puchkaman/public/hero/*.jpg
!apps/puchkaman/public/catering/*.png
