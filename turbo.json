{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "node_modules/@foundry/eslint-config/**"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": ["tsconfig.tsbuildinfo"] },
    "test": {},
    "dev": { "cache": false, "persistent": true }
  }
}
