{
	# ACME account email for Let's Encrypt (auto-TLS). Set ACME_EMAIL in .env.production.
	email {$ACME_EMAIL}
}

# www → apex. This block previously SERVED www alongside the apex rather than
# redirecting, which made www a second live origin: BETTER_AUTH_URL is the apex,
# so a sign-in posted from www carries an Origin better-auth's CSRF check
# rejects. Redirecting removes the second origin instead of allow-listing it.
www.puchkaman.ca {
	redir https://puchkaman.ca{uri} permanent
}

# puchkaman is the ONLY app on this box.
puchkaman.ca {
	encode zstd gzip

	# X-Real-IP is OVERWRITTEN (not appended) with the real socket peer, so a
	# client cannot choose it. better-auth trusts only this header for rate
	# limiting, and /api/checkout/pay forwards it to Clover for fraud scoring.
	# Do not drop this without changing lib/auth/index.ts too.
	reverse_proxy puchkaman-web:3000 {
		header_up X-Real-IP {remote_host}
	}
}
