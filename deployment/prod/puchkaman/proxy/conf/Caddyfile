{
	# ACME account email for Let's Encrypt (auto-TLS). Set ACME_EMAIL in .env.production.
	email {$ACME_EMAIL}
}

# www → apex. This block previously SERVED www alongside the apex rather than
# redirecting, which made www a second live origin: BETTER_AUTH_URL is the apex,
# so a sign-in posted from www carries an Origin better-auth's CSRF check
# rejects. Redirecting removes the second origin instead of allow-listing it.
www.puchkaman.ca {
	redir https://puchkaman.ca{uri} permanent
}

# puchkaman is the ONLY app on this box.
puchkaman.ca {
	encode zstd gzip

	# Request timing for sizing Neon (how many 5-min windows see traffic), shipped
	# to CloudWatch (/puchkaman/prod, stream caddy). Query strings carry magic-link and
	# payment-link tokens, so they are cut; headers and client IPs are dropped.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Only real routes reach the app. Crawlers request URLs this site never had
	# (gambling spam, WordPress probes); each one would render the layout and wake
	# the Neon database just to return a 404. Caddy answers them itself instead.
	# The allowlist mirrors apps/puchkaman/app's top-level routes plus public/ and
	# the next.config redirects; apps/puchkaman/__tests__/caddy-allowlist.test.ts
	# fails if a new top-level route is added to the app but not here.
	# Gambling-spam words inside an allowed prefix (e.g. /eats/casino-x) still get
	# 410 Gone, which tells search engines to drop the URL. Short words like "bet"
	# or "slot" are left out because they can appear in a product slug.
	@spam path_regexp spam (?i)(casino|roulette|poker|jackpot|blackjack|baccarat|gambl|sportsbook|betting)
	@notapp not path_regexp ^/(|(about|accept-invitation|account|api|cart|catering|checkout|contact|dashboard|eats|events|faq|forgot-password|fusion|locations|login|me|no-access|order|privacy|reviews|set-password|signup|terms|track|unsubscribe|_next|menu|productsmenu|hero|instagram|\.well-known)(/.*)?|logo\.webp|icon\.png|favicon\.ico|robots\.txt|sitemap\.xml)$

	route {
		respond @spam 410
		respond @notapp 404

		# X-Real-IP is OVERWRITTEN (not appended) with the real socket peer, so a
		# client cannot choose it. better-auth trusts only this header for rate
		# limiting, and /api/checkout/pay forwards it to Clover for fraud scoring.
		# Do not drop this without changing lib/auth/index.ts too.
		reverse_proxy puchkaman-web:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
