{
	# ACME account email for Let's Encrypt (auto-TLS). Set ACME_EMAIL in .env.production.
	email {$ACME_EMAIL}
}

# www → apex. This block previously SERVED www alongside the apex rather than
# redirecting, which made www a second live origin: BETTER_AUTH_URL is the apex,
# so a sign-in posted from www carries an Origin better-auth's CSRF check
# rejects. Redirecting removes the second origin instead of allow-listing it.
www.puchkaman.ca {
	redir https://puchkaman.ca{uri} permanent
}

# puchkaman is the ONLY app on this box.
puchkaman.ca {
	encode zstd gzip

	# Request timing for sizing Neon (how many 5-min windows see traffic), shipped
	# to CloudWatch (/puchkaman/prod, stream caddy). Query strings carry magic-link and
	# payment-link tokens, so they are cut; headers and client IPs are dropped.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>tls delete
				resp_headers delete
			}
		}
	}

	# Crawlers keep requesting gambling-spam URLs this site never had (likely
	# indexed from the domain's past). Answering here keeps them off the app, so
	# they don't render the layout and wake the Neon database, and 410 Gone tells
	# search engines to drop them faster than a 404. Only unambiguous gambling
	# words: short ones like "bet" or "slot" could be in a product slug.
	@spam path_regexp spam (?i)(casino|roulette|poker|jackpot|blackjack|baccarat|gambl|sportsbook|betting)
	respond @spam 410

	# X-Real-IP is OVERWRITTEN (not appended) with the real socket peer, so a
	# client cannot choose it. better-auth trusts only this header for rate
	# limiting, and /api/checkout/pay forwards it to Clover for fraud scoring.
	# Do not drop this without changing lib/auth/index.ts too.
	reverse_proxy puchkaman-web:3000 {
		header_up X-Real-IP {remote_host}
	}
}
