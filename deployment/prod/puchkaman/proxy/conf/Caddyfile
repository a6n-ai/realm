{
	# ACME account email for Let's Encrypt (auto-TLS). Set ACME_EMAIL in .env.production.
	email {$ACME_EMAIL}
}

# puchkaman is the ONLY app on this box. www → apex handled by Caddy.
puchkaman.ca, www.puchkaman.ca {
	encode zstd gzip

	# X-Real-IP is OVERWRITTEN (not appended) with the real socket peer, so a
	# client cannot choose it. better-auth trusts only this header for rate
	# limiting, and /api/checkout/pay forwards it to Clover for fraud scoring.
	# Do not drop this without changing lib/auth/index.ts too.
	reverse_proxy puchkaman-web:3000 {
		header_up X-Real-IP {remote_host}
	}
}
