# Reference for Xplorers prod config. deploy.sh GENERATES .env.production from
# SSM Parameter Store (/xplorers/prod/<KEY>) in **ap-southeast-1** — never
# us-east-1 (that region is tiffin-grab / puchkaman).
#
#   aws ssm put-parameter --region ap-southeast-1 --overwrite \
#     --name /xplorers/prod/<KEY> --type SecureString --value '<value>'
#   cd ~/realm/deployment/prod/xplorers && ./deploy.sh

# --- Core ---
NODE_ENV=production
LOG_LEVEL=info
AWS_REGION=ap-southeast-1

# --- Database (Neon project xplorers, aws-ap-southeast-1) ---
# Pooled endpoint (-pooler host) for the app; direct endpoint for migrations.
# Drop channel_binding=require from the console string: postgres.js sends
# unknown params to the server as startup settings.
DATABASE_URL=postgresql://xplorers:PASSWORD@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/xplorers?sslmode=require
DIRECT_DATABASE_URL=postgresql://xplorers:PASSWORD@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/xplorers?sslmode=require

# --- Auth ---
BETTER_AUTH_URL=https://xplorers.a6n.ai
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

# --- Reverse proxy / TLS (copied into proxy/.env.production on the box) ---
ACME_EMAIL=hello@xplorers.a6n.ai

# --- Email (SES in ap-southeast-1). Instance role; no AWS keys here. ---
NOTIFY_FROM_EMAIL=hello@xplorers.a6n.ai
NOTIFY_FROM_NAME=Xplorers
SES_CONFIGURATION_SET=xplorers-prod
