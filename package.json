{
  "name": "realm",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:fresh": "lsof -ti :3000 | xargs kill -9 2>/dev/null; rm -rf apps/tiffin-grab/.next && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "dependencies": {
    "@foundry/ai": "github:a6n-ai/foundry#path:packages/ai",
    "@foundry/auth": "github:a6n-ai/foundry#path:packages/auth",
    "@foundry/auth-ui": "github:a6n-ai/foundry#path:packages/auth-ui",
    "@foundry/clover": "github:a6n-ai/foundry#path:packages/clover",
    "@foundry/coupons": "github:a6n-ai/foundry#path:packages/coupons",
    "@foundry/google-reviews": "github:a6n-ai/foundry#path:packages/google-reviews",
    "@foundry/order-tracking": "github:a6n-ai/foundry#path:packages/order-tracking",
    "@foundry/payments": "github:a6n-ai/foundry#path:packages/payments",
    "@foundry/places": "github:a6n-ai/foundry#path:packages/places",
    "@foundry/routes": "github:a6n-ai/foundry#path:packages/routes",
    "@foundry/storage": "github:a6n-ai/foundry#path:packages/storage",
    "@foundry/wallet": "github:a6n-ai/foundry#path:packages/wallet"
  },
  "devDependencies": {
    "jose": "^6.2.3",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
