// Secrets (never in this file): BETTER_AUTH_SECRET, RELAY_API_KEY. Set with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a6n",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // The Vite plugin supplies the directory (dist/client).
  "assets": { "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "crm.a6n.ai", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://crm.a6n.ai",
    "MAILER": "relay",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "a6n",
      // set after: wrangler d1 create a6n (owner approval)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "services": [{ "binding": "RELAY", "service": "relay", "entrypoint": "RelayRpc" }],
}
