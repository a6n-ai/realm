# Workers static assets (wrangler `assets`) read this; next.config headers() never reach files in public/.
# Names are not content-hashed, so a week, not immutable: a replaced hero.mp4 shows within 7 days.
/landing/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/refer-card/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/watermark/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
