DATABASE_URL=postgres://lawbringr@localhost:5432/tiffin
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client ID, Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google. Button hidden until both set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clover Developer App (App Settings → App ID / App Secret). Redirect URI:
#   {BETTER_AUTH_URL}/api/integrations/clover/callback
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_ENVIRONMENT=sandbox
CLOVER_REGION=na

# OptimoRoute (delivery routing). Secret: prod reads it from SSM
# (/tiffin-grab/prod/OPTIMOROUTE_API_KEY, SecureString) which deploy.sh writes into
# .env.production; dev reads it from the gitignored .env.local. Never commit a value.
# Unset is a supported state — lib/services/optimoroute/config.ts returns null and the
# routes page shows an explanatory empty state rather than failing.
# The API base URL is a constant in lib/services/optimoroute/client.ts, not an env var.
OPTIMOROUTE_API_KEY=

# Google Reviews plugin (Places API, New). Secret: prod reads it from SSM
# (/tiffin-grab/prod/GOOGLE_PLACES_API_KEY, SecureString) via deploy.sh; dev from
# .env.local. Never commit a value. Unset = every public review spot stays hidden.
GOOGLE_PLACES_API_KEY=

# Google Analytics 4 (Admin → Data streams → Measurement ID, starts with G-).
# Runtime (not NEXT_PUBLIC_): prod reads /tiffin-grab/prod/GA_MEASUREMENT_ID from
# SSM into .env.production. Unset = no gtag script.
GA_MEASUREMENT_ID=

# Marketing campaign email footer (contact-list bulk sends). Unset = campaign
# emails are skipped entirely (fail-closed) rather than sent with no
# unsubscribe link/postal address, which is what CASL actually penalises.
# Transactional email is unaffected either way.
UNSUBSCRIBE_SECRET=
CAMPAIGN_POSTAL_ADDRESS=
# Base URL for the /unsubscribe link. Falls back to SITE_URL when unset.
CAMPAIGN_BASE_URL=
CAMPAIGN_SENDER_NAME=
# Marketing From address. Set → campaigns/marketing mail leave from it while
# transactional mail uses NOTIFY_FROM_EMAIL, so spam complaints on marketing
# don't drag down order/OTP delivery. Unset → everything uses NOTIFY_FROM_EMAIL.
CAMPAIGN_FROM_EMAIL=
# SES config sets (prod only). Campaign mail uses SES_CONFIGURATION_SET (open/click
# stats); transactional mail uses SES_TRANSACTIONAL_CONFIGURATION_SET (no tracking,
# falls back to SES_CONFIGURATION_SET). See deployment/email/README.md.
SES_CONFIGURATION_SET=
SES_TRANSACTIONAL_CONFIGURATION_SET=
# Master key that encrypts integration secrets at rest (Stripe secret key, webhook secret).
# 32 random bytes, e.g. `openssl rand -base64 32`. Losing it means reconnecting Stripe.
INTEGRATIONS_ENCRYPTION_KEY=
