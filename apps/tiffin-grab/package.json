{
  "name": "tiffin-grab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project unit-mocked",
    "test:db": "vitest run --project db",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:admin": "playwright test -c e2e/playwright.config.ts --project=admin",
    "test:e2e:admin:order-revamp": "playwright test -c e2e/playwright.config.ts --project=admin e2e/admin/order-revamp.spec.ts",
    "test:e2e:optimoroute-live": "OPTIMOROUTE_LIVE_TEST=1 playwright test -c e2e/playwright.config.ts --project=admin e2e/admin/optimoroute-live.spec.ts",
    "test:e2e:features": "playwright test -c e2e/playwright.config.ts --project=admin e2e/admin/order-revamp.spec.ts && playwright test -c e2e/playwright.config.ts --project=customer e2e/customer/deliveries-ux.spec.ts",
    "test:e2e:public": "playwright test -c e2e/playwright.config.ts --project=public",
    "test:e2e:customer": "playwright test -c e2e/playwright.config.ts --project=customer",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit:skeletons": "playwright test skeleton-audit/capture.ts"
  },
