// xplorers on Cloudflare Workers (OpenNext). Secrets are never in this file; set them with
// `wrangler secret put <NAME> [--env preview]`: BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
// GOOGLE_CLIENT_SECRET, REALTIME_SECRET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
// FILES_S3_ACCESS_KEY_ID, FILES_S3_SECRET_ACCESS_KEY. Runbook: deployment/cloudflare/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xplorers",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "observability": { "enabled": true },
  // Run next to the database (Neon aws-ap-southeast-1), not next to the visitor: pages
  // make many queries, so DB round trips dominate (Delhi->Singapore was ~6s per page).
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  // No keep-warm cron while xplorers is a pilot (owner, 2026-11-02): warm by hand before a
  // demo with GET /api/health. An empty list also clears any cron deployed earlier.
  "triggers": { "crons": [] },
  // Reachable only through its custom domain, never *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "xplorers.a6n.ai", "custom_domain": true }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xplorers" }],
  // Hyperdrive xplorers-prod -> Neon aged-dust-56644803 production, direct endpoint.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9d1bcab0f81d462997e9bdb5529416cd",
      "localConnectionString": "postgres://xplorers:local@localhost:5432/xplorers"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "AWS_REGION": "ap-southeast-1",
    "FILES_S3_REGION": "ap-southeast-1",
    "FILES_S3_BUCKET": "xplorers-files-947042607945-ap-southeast-1-an",
    "NOTIFY_FROM_EMAIL": "hello@xplorers.a6n.ai",
    "NOTIFY_FROM_NAME": "Xplorers",
    "SES_CONFIGURATION_SET": "xplorers-prod",
    "BETTER_AUTH_URL": "https://xplorers.a6n.ai",
    "REALTIME_URL": "https://rt.xplorers.a6n.ai"
  },
  "env": {
    "preview": {
      "name": "xplorers-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "next.xplorers.a6n.ai", "custom_domain": true }],
      "triggers": { "crons": [] },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xplorers-preview" }],
      // Hyperdrive xplorers-preview -> Neon branch `preview` (br-purple-king-aznpd826).
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "4901a4b146984aa7854caaa8a7d9eca1",
          "localConnectionString": "postgres://xplorers:local@localhost:5432/xplorers"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "AWS_REGION": "ap-southeast-1",
        "FILES_S3_REGION": "ap-southeast-1",
        "FILES_S3_BUCKET": "xplorers-files-947042607945-ap-southeast-1-an",
        "NOTIFY_FROM_EMAIL": "hello@xplorers.a6n.ai",
        "NOTIFY_FROM_NAME": "Xplorers",
        "SES_CONFIGURATION_SET": "xplorers-prod",
        "BETTER_AUTH_URL": "https://next.xplorers.a6n.ai",
        "REALTIME_URL": "https://rt.xplorers.a6n.ai"
      }
    }
  }
}
