DATABASE_URL=postgres://lawbringr@localhost:5432/puchkaman
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Clover (Settings → Integrations). App secret stays server-side only.
# Create a sandbox app at https://sandbox.dev.clover.com/ and set the
# Site URL / OAuth redirect to:
#   {BETTER_AUTH_URL}/api/integrations/clover/callback
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# sandbox | production (default: sandbox)
CLOVER_ENVIRONMENT=sandbox
# na | eu | la — production region only (default: na)
CLOVER_REGION=na
# App webhooks: Dashboard → App Settings → Webhooks → Clover Auth Code (after URL verify)
# Callback URL: {BETTER_AUTH_URL}/api/integrations/clover/webhook (HTTPS; tunnel for local)
CLOVER_WEBHOOK_AUTH=
