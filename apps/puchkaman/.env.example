DATABASE_URL=postgres://lawbringr@localhost:5432/puchkaman
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Clover (Settings → Integrations). App secret stays server-side only.
# Create a sandbox app at https://sandbox.dev.clover.com/ and set the
# Site URL / OAuth redirect to:
#   {BETTER_AUTH_URL}/api/integrations/clover/callback
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# sandbox | production (default: sandbox)
CLOVER_ENVIRONMENT=sandbox
# na | eu | la — production region only (default: na)
CLOVER_REGION=na
# App webhooks: Dashboard → App Settings → Webhooks → Clover Auth Code (after URL verify)
# Callback URL: {BETTER_AUTH_URL}/api/integrations/clover/webhook (HTTPS; tunnel for local)
CLOVER_WEBHOOK_AUTH=

# Delivery address lookup (@realm/places). Unset = Google primary, AWS/Nominatim
# fallback. Set to "aws" to try AWS Location first instead (see PROJECT.md).
PLACES_PROVIDER=
# Server-side Google Places API (New) key. Unset = Google is skipped everywhere
# (suggest/resolve fall through to AWS/Nominatim); with AWS_REGION also unset,
# checkout's address dropdown returns no suggestions (a one-time warning logs it).
GOOGLE_PLACES_API_KEY=
# AWS region for Location Service (geo-places), e.g. us-east-1. Unset = AWS is
# effectively unusable (SDK calls fail immediately, logged per request).
AWS_REGION=
# Basemap style URL for the admin delivery-zone map (MapLibre). Unset = keyless
# OpenStreetMap raster tiles, which need no credential and are the default.
# Point this at a same-origin proxy to serve Amazon Location vector tiles
# instead; do not put a vendor key here, it is exposed to the browser.
NEXT_PUBLIC_MAP_STYLE_URL=

# Relay (standalone notify product). Tenant API key from Relay → Tenants.
# RELAY_API_URL=http://localhost:3010
# RELAY_API_KEY=

# Direct send (SES default, or SMTP). Not the tenant API key.
# EMAIL_TRANSPORT=ses
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
